# העתק/י קובץ זה ל-.env ומלא/י את הפרטים שלך
# PostgreSQL מקומי (חינמי) - ראה/י README.md להוראות התקנה

DB_HOST=localhost
DB_PORT=5432
DB_NAME=supermarket_prices
DB_USER=postgres
DB_PASSWORD=postgres

# תיקיות עבודה של תהליך ה-ETL
DUMPS_FOLDER=dumps
OUTPUTS_FOLDER=outputs

# --- אופציונלי: להגביל היקף בזמן בדיקות (כדי לא להוריד הכל) ---
# רשימת רשתות מופרדת בפסיקים, למשל: SHUFERSAL,RAMI_LEVY
# ENABLED_SCRAPERS=
# סוגי קבצים מופרדים בפסיקים: STORE_FILE,PRICE_FILE,PROMO_FILE
# ENABLED_FILE_TYPES=
# מספר קבצים מקסימלי להורדה (לבדיקות מהירות)
# LIMIT=5

# מספר תהליכים מקבילים
NUMBER_OF_PROCESSES=4

FLASK_PORT=5000
