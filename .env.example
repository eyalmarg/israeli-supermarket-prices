# העתק/י קובץ זה ל-.env ומלא/י את הפרטים שלך
# PostgreSQL מקומי (חינמי) - ראה/י README.md להוראות התקנה

DB_HOST=localhost
DB_PORT=5432
DB_NAME=supermarket_prices
DB_USER=postgres
DB_PASSWORD=postgres

# תיקיית ההורדות של תהליך ה-ETL
DUMPS_FOLDER=dumps

# --- אופציונלי: להגביל היקף בזמן בדיקות (כדי לא להוריד הכל) ---
# רשימת רשתות מופרדת בפסיקים, למשל: SHUFERSAL,RAMI_LEVY,VICTORY_NEW_SOURCE
# ENABLED_SCRAPERS=
# מספר קבצים מקסימלי לכל רשת (לבדיקות מהירות)
# LIMIT=5

# מספר רשתות שמורדות במקביל
NUMBER_OF_PROCESSES=4

FLASK_PORT=5000
